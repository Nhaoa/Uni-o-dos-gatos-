rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'advbneto29@gmail.com'
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isRoomMember(roomData) {
      return isSignedIn() && (
        roomData.ownerUid == request.auth.uid
        || roomData.partnerUid == request.auth.uid
      );
    }

    function isParentRoomMember(roomId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId))
        && (
          isAdmin()
          || get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid
          || get(/databases/$(database)/documents/rooms/$(roomId)).data.partnerUid == request.auth.uid
        );
    }

    function isValidCat(cat) {
      return cat is map
        && cat.size() >= 15
        && cat.size() <= 18
        && cat.breed is string && cat.breed.size() >= 1 && cat.breed.size() <= 32
        && cat.outfit is string && cat.outfit.size() >= 1 && cat.outfit.size() <= 40
        && cat.accessory is string && cat.accessory.size() >= 1 && cat.accessory.size() <= 40
        && cat.expression in ['happy', 'pet', 'normal']
        && cat.hunger is number && cat.hunger >= 0 && cat.hunger <= 100
        && cat.energy is number && cat.energy >= 0 && cat.energy <= 100
        && cat.happiness is number && cat.happiness >= 0 && cat.happiness <= 100
        && cat.speech is string && cat.speech.size() <= 160;
    }

    function isValidRoomSnapshot(data) {
      return data.keys().hasOnly([
          'roomId', 'ownerUid', 'partnerUid', 'cat1Uid', 'cat2Uid', 'roomPasswordHash',
          'lastStatsUpdateTime', 'createdAt', 'updatedAt',
          'nicknames', 'loveScore', 'streak', 'scores', 'presence', 'wallets', 'inventories',
          'unlockedItems', 'lastRewardDates', 'cat1', 'cat2', 'letters', 'onlineRooms',
          'boardGames', 'skyHopLeaderboard', 'achievements', 'achievementStats',
          'galleryOrder', 'galleryHashes', 'galleryDriveFolder'
        ])
        && data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 64
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.partnerUid is string && data.partnerUid.size() <= 128
        && (!('cat1Uid' in data) || (data.cat1Uid is string && data.cat1Uid.size() <= 128))
        && (!('cat2Uid' in data) || (data.cat2Uid is string && data.cat2Uid.size() <= 128))
        && (!('roomPasswordHash' in data) || (data.roomPasswordHash is string && data.roomPasswordHash.size() <= 160))
        && (!('galleryDriveFolder' in data) || data.galleryDriveFolder == null || data.galleryDriveFolder is map)
        && data.lastStatsUpdateTime is number && data.lastStatsUpdateTime >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.nicknames is map
        && data.nicknames.cat1 is string && data.nicknames.cat1.size() >= 1 && data.nicknames.cat1.size() <= 18
        && data.nicknames.cat2 is string && data.nicknames.cat2.size() >= 1 && data.nicknames.cat2.size() <= 18
        && data.loveScore is number && data.loveScore >= 0 && data.loveScore <= 100
        && data.streak is map && data.streak.current is number && data.streak.current >= 0
        && data.scores is map && data.scores.cat1Wins is number && data.scores.cat2Wins is number
        && data.presence is map && data.presence.syncedToday is bool
        && data.wallets is map
        && data.wallets.cat1 is map && data.wallets.cat1.fish is number && data.wallets.cat1.fish >= 0 && data.wallets.cat1.fish <= 10000000
        && data.wallets.cat2 is map && data.wallets.cat2.fish is number && data.wallets.cat2.fish >= 0 && data.wallets.cat2.fish <= 10000000
        && data.inventories is map
        && data.unlockedItems is map
        && data.lastRewardDates is map
        && isValidCat(data.cat1)
        && isValidCat(data.cat2)
        && data.letters is list && data.letters.size() <= 80
        && data.onlineRooms is map
        && data.boardGames is map
        && data.skyHopLeaderboard is list && data.skyHopLeaderboard.size() <= 10
        && data.achievements is map
        && data.achievementStats is map
        && data.galleryOrder is list && data.galleryOrder.size() <= 60
        && data.galleryHashes is map && data.galleryHashes.size() <= 60;
    }

    function isValidGalleryExhibit(data) {
      return data.keys().hasOnly([
          'id', 'roomId', 'authorUid', 'kind', 'title', 'description',
          'url', 'imageUrl', 'videoUrl', 'driveFileId', 'driveFolderId',
          'mimeType', 'fileSizeBytes', 'storage', 'frameStyle', 'addedBy',
          'authorName', 'occasionDate', 'position', 'exhibitCreatedAt',
          'isStarter', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 64
        && isValidId(data.authorUid)
        && data.kind in ['site', 'image', 'video']
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 80
        && data.description is string && data.description.size() >= 3 && data.description.size() <= 420
        && (!('url' in data) || (data.url is string && data.url.size() <= 2000))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500000))
        && (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 2000))
        && (!('driveFileId' in data) || (data.driveFileId is string && data.driveFileId.size() <= 128))
        && (!('driveFolderId' in data) || (data.driveFolderId is string && data.driveFolderId.size() <= 128))
        && (!('mimeType' in data) || (data.mimeType is string && data.mimeType.size() <= 96))
        && (!('fileSizeBytes' in data) || (data.fileSizeBytes is number && data.fileSizeBytes >= 0))
        && (!('storage' in data) || data.storage in ['drive', 'url', 'inline'])
        && data.frameStyle in ['gold', 'oak', 'modern', 'crimson']
        && data.addedBy in ['cat1', 'cat2']
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 32
        && (!('occasionDate' in data) || (data.occasionDate is string && data.occasionDate.size() <= 24))
        && data.position is number && data.position >= 0 && data.position <= 60
        && data.exhibitCreatedAt is number && data.exhibitCreatedAt >= 0
        && data.isStarter is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if false;
      allow write: if false;
    }

    match /rooms/{roomId} {
      allow get: if isSignedIn()
        && isValidId(roomId)
        && (
          isAdmin()
          || resource == null
          || isRoomMember(existing())
          || resource.data.partnerUid == ''
        );
      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(roomId)
        && isValidRoomSnapshot(incoming())
        && request.resource.data.roomId == roomId
        && incoming().ownerUid == request.auth.uid
        && request.resource.data.partnerUid == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(roomId)
        && isValidRoomSnapshot(request.resource.data)
        && request.resource.data.roomId == resource.data.roomId
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && request.resource.data.updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().partnerUid == '' && incoming().partnerUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partnerUid', 'cat1Uid', 'cat2Uid', 'updatedAt'])
            && (!('cat1Uid' in resource.data) || resource.data.cat1Uid == '' || request.resource.data.cat1Uid == resource.data.cat1Uid)
            && (!('cat2Uid' in resource.data) || resource.data.cat2Uid == '' || request.resource.data.cat2Uid == resource.data.cat2Uid)
          )
          || (
            isRoomMember(resource.data)
            && request.resource.data.partnerUid == resource.data.partnerUid
            && (!('cat1Uid' in resource.data) || resource.data.cat1Uid == '' || request.resource.data.cat1Uid == resource.data.cat1Uid)
            && (!('cat2Uid' in resource.data) || resource.data.cat2Uid == '' || request.resource.data.cat2Uid == resource.data.cat2Uid)
          )
        );

      allow delete: if false;

      match /gallery/{exhibitId} {
        allow get: if isSignedIn()
          && isValidId(roomId)
          && isValidId(exhibitId)
          && isParentRoomMember(roomId);
        allow list: if false;

        allow create: if isSignedIn()
          && isValidId(roomId)
          && isValidId(exhibitId)
          && isValidGalleryExhibit(incoming())
          && request.resource.data.id == exhibitId
          && request.resource.data.roomId == roomId
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && isParentRoomMember(roomId);

        allow update: if isSignedIn()
          && isValidId(roomId)
          && isValidId(exhibitId)
          && isValidGalleryExhibit(request.resource.data)
          && request.resource.data.id == resource.data.id
          && request.resource.data.roomId == resource.data.roomId
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && isParentRoomMember(roomId);

        allow delete: if isSignedIn()
          && isValidId(roomId)
          && isValidId(exhibitId)
          && isParentRoomMember(roomId);
      }
    }
  }
}
